{
  "name": "manexion-salon-os",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @salonos/web",
    "build": "npm run build -w @salonos/web",
    "start": "npm run start -w @salonos/web",
    "typecheck": "npm run typecheck -w @salonos/core && npm run typecheck -w @salonos/web",
    "test": "vitest run",
    "test:unit": "vitest run packages/core",
    "test:integration": "vitest run apps/web/tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/db/prisma/schema.prisma",
    "db:reset": "prisma db push --force-reset --schema packages/db/prisma/schema.prisma",
    "db:seed": "cd apps/web && tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "postinstall": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.20.4",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
