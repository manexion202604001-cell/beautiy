# ── Required ─────────────────────────────────────────────
DATABASE_URL=postgresql://salonos:salonos@localhost:5432/salonos
# Public base URL (used in booking/manage/share links sent to customers)
APP_URL=http://localhost:3000
# PII field encryption + blind index keys (>=16 chars, random, NEVER change after data exists)
PII_ENCRYPTION_KEY=
PII_HASH_KEY=
# Bearer secret for /api/cron (automations, sync retries)
CRON_SECRET=
# 1 = demo mode in production (OTP codes shown on screen, sandbox sends). Remove for real operation.
DEMO_MODE=

# ── Object storage (optional; falls back to Postgres blobs) ─
S3_ENDPOINT=
S3_REGION=ap-northeast-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Messaging (optional; sandbox when empty) ──────────────
# Per-organization LINE credentials are set in 設定 > 外部連携. These are fallbacks.
LINE_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=

# ── Payments (optional; sandbox when empty) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Redis is reserved for future caching/queues; booking locks use Postgres advisory locks.
REDIS_URL=redis://localhost:6379
