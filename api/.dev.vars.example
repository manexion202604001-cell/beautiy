# ローカル開発用の秘密情報。このファイルを .dev.vars にコピーして使う（.dev.vars はコミットしない）
JWT_SECRET=change-me-local-dev-secret-at-least-32-chars

# wrangler.dev.toml の [vars] をローカル用に上書き（localhost ではドメイン付きCookieが使えないため空にする）
COOKIE_DOMAIN=
API_URL=http://localhost:8787

# 以下は任意（未設定の場合、その機能は無効）
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# RESEND_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# RPI_API_KEY=
# ANTHROPIC_API_KEY=
