# ローカル開発: このファイルを .env.local にコピーする
# API URL（pnpm dev:api:local のローカルAPI）
NEXT_PUBLIC_API_URL=http://localhost:8787

# URLに store_id が無いときに使う店舗ID（seed.sql の店舗）
NEXT_PUBLIC_STORE_ID=store-1

# LINE受付(intake)用 LIFF設定（LINEログインチャネル client_id -> LIFF ID のJSON）
NEXT_PUBLIC_INTAKE_LIFF_MAP={}
NEXT_PUBLIC_INTAKE_DEFAULT_LIFF_ID=
