# --- core
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://salon:salon@localhost:5432/salon
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# behind a load balancer: true | <hops> | <proxy CIDRs>
TRUST_PROXY=false

# --- secrets (MUST be changed in production)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
TOKEN_SECRET=dev-only-token-secret-change-me
# 32 bytes base64:  openssl rand -base64 32
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=

# --- storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=
# S3_REGION=ap-northeast-1
# S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- messaging: mock | live
LINE_DRIVER=mock
EMAIL_DRIVER=mock
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=no-reply@example.com
SMS_DRIVER=mock

# --- payments: mock | stripe
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- AI (optional; heuristic fallback when unset)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- dev only
DEV_EXPOSE_OTP=true
