#!/bin/sh
# Sourced by the nginx image entrypoint before the template step.
# Hosts that hand out the API's private address as "host:port" (Render: fromService hostport)
# set API_HOSTPORT instead of a full API_UPSTREAM URL.
if [ -n "${API_HOSTPORT:-}" ]; then
  export API_UPSTREAM="http://${API_HOSTPORT}"
fi
