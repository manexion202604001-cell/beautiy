# Vite dev server: proxy target for /v1 (the API)
VITE_API_PROXY=http://localhost:4100

# API base path used by the browser (default: relative /v1 → same origin / reverse proxy)
# VITE_API_BASE_URL=/v1

# Show the "LINEでログイン（開発用モック）" button outside of dev builds (API LINE_DRIVER=mock)
# VITE_LINE_MOCK=true

# Dev server port
# WEB_PORT=5173
